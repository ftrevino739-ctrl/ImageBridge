<Application x:Class="ImageBridge.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBackground" Color="#0B1020"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#121A2B"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#26344B"/>
    <SolidColorBrush x:Key="Accent" Color="#8AB4FF"/>
    <SolidColorBrush x:Key="MutedText" Color="#91A0B8"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E8EEF8"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F4F7FC"/>
      <Setter Property="Background" Value="#0D1525"/>
      <Setter Property="BorderBrush" Value="#34445F"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,6,0,12"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="#F4F7FC"/>
      <Setter Property="Background" Value="#0D1525"/>
      <Setter Property="BorderBrush" Value="#34445F"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,6,0,12"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F7FC"/>
      <Setter Property="Background" Value="#24344F"/>
      <Setter Property="BorderBrush" Value="#405779"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
