<Window x:Class="ImageBridge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageBridge" Height="820" Width="1320" MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="#090E19"
        Loaded="Window_Loaded" Closed="Window_Closed">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#91A0B8"/>
    <SolidColorBrush x:Key="Panel" Color="#111B2B"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#26364D"/>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#AAB8CE"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,2,0,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#1B2A40"/>
                <Setter Property="Foreground" Value="#F4F7FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#263C5B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PanelBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F0F4FC"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E8EEF8"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F4F7FC"/>
      <Setter Property="Background" Value="#0B1422"/>
      <Setter Property="BorderBrush" Value="#34445F"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="Margin" Value="0,7,0,14"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="#F4F7FC"/>
      <Setter Property="Background" Value="#0B1422"/>
      <Setter Property="BorderBrush" Value="#34445F"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="Margin" Value="0,7,0,14"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F7FC"/>
      <Setter Property="Background" Value="#20334E"/>
      <Setter Property="BorderBrush" Value="#3A5273"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#0B1422"/>
      <Setter Property="BorderBrush" Value="#26364D"/>
      <Setter Property="Foreground" Value="#DCE6F5"/>
      <Setter Property="Padding" Value="8"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Grid.Column="0" Background="#0D1625" BorderBrush="#1F2D42" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="19,24,19,18">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
            <Border Width="42" Height="42" CornerRadius="14" Background="#203B60" BorderBrush="#456A9B" BorderThickness="1">
              <TextBlock Text="✧" FontSize="27" Foreground="#B9D7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="ImageBridge" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Text="DESKTOP WORKSPACE" FontSize="9" Foreground="#8293AD" Margin="1,3,0,0"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="WORKSPACE" FontSize="10" Foreground="#6F819C" Margin="5,0,0,9" FontWeight="SemiBold"/>
          <Button Content="⌂   Inicio" Tag="Inicio" Click="Nav_Click" Style="{StaticResource NavButton}"/>
          <Button Content="▤   Archivos" Tag="Archivos" Click="Nav_Click" Style="{StaticResource NavButton}"/>
          <Button Content="↑   Subir archivos" Tag="Subir archivos" Click="Nav_Click" Style="{StaticResource NavButton}"/>
          <Button Content="◷   Actividad" Tag="Historial" Click="Nav_Click" Style="{StaticResource NavButton}"/>
          <TextBlock Text="ADMINISTRACIÓN" FontSize="10" Foreground="#6F819C" Margin="5,25,0,9" FontWeight="SemiBold"/>
          <Button Content="⌘   Integraciones" Tag="Integraciones" Click="Nav_Click" Style="{StaticResource NavButton}"/>
          <Button Content="◫   Almacenamiento" Tag="Almacenamiento" Click="Nav_Click" Style="{StaticResource NavButton}"/>
          <Button Content="⚙   Configuración" Tag="Configuración" Click="Nav_Click" Style="{StaticResource NavButton}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Margin="15" Padding="14" CornerRadius="13" Background="#121F31" BorderBrush="#293C56" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="ESTADO DEL SERVIDOR" FontSize="9" Foreground="#8192AA" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
              <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#77849A" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="SidebarStatusText" Text="Sin comprobar" FontSize="12"/>
            </StackPanel>
            <TextBlock Text="Tu espacio privado de archivos" FontSize="10" Foreground="#71839D" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- Main workspace -->
    <Grid Grid.Column="1" Margin="30,25,30,25">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="0,0,0,22">
        <StackPanel>
          <TextBlock x:Name="PageTitle" Text="Inicio" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageDescription" Text="Tu centro de control para archivos y conexiones de IA." Foreground="#91A0B8" Margin="0,5,0,0" FontSize="12"/>
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="13,8" CornerRadius="18" Background="#142238" BorderBrush="#2A3C57" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7" Height="7" Fill="#77849A" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ConnectionStatusText" Text="Desconectado" FontSize="11" Foreground="#C0CDE0"/>
          </StackPanel>
        </Border>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>

          <!-- HOME -->
          <StackPanel x:Name="HomePage">
            <Border CornerRadius="18" Padding="25" Margin="0,0,0,17" BorderBrush="#345078" BorderThickness="1">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#1C3555" Offset="0"/>
                  <GradientStop Color="#142238" Offset="0.55"/>
                  <GradientStop Color="#111B2B" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="TU ESPACIO DE TRABAJO" FontSize="10" Foreground="#A9C9F2" FontWeight="SemiBold"/>
                  <TextBlock Text="Tus archivos. Un solo puente." FontSize="25" FontWeight="SemiBold" Margin="0,8,0,5"/>
                  <TextBlock Text="Centraliza cargas, revisa actividad y administra las conexiones de ImageBridge." FontSize="12" Foreground="#B3C4DA" TextWrapping="Wrap" MaxWidth="570"/>
                  <Button Content="＋  Seleccionar archivos" Click="SelectUpload_Click" HorizontalAlignment="Left" Margin="0,18,0,0" Background="#D9E8FF" Foreground="#14243C" BorderBrush="#D9E8FF"/>
                </StackPanel>
                <Border Grid.Column="1" Width="94" Height="94" CornerRadius="28" Background="#FFFFFF0D" BorderBrush="#FFFFFF25" BorderThickness="1" VerticalAlignment="Center" Margin="22,0,4,0">
                  <TextBlock Text="✧" FontSize="54" Foreground="#BBD8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>

            <Grid Margin="0,0,0,17">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0" Padding="17">
                <StackPanel>
                  <TextBlock Text="CONEXIÓN" FontSize="10" Foreground="#8FA1BB" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ConnectionCardText" Text="Sin configurar" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5" TextWrapping="Wrap"/>
                  <TextBlock Text="Estado de ImageBridge API" FontSize="10" Foreground="#8294AD"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}" Margin="0" Padding="17">
                <StackPanel>
                  <TextBlock Text="ALMACENAMIENTO" FontSize="10" Foreground="#8FA1BB" FontWeight="SemiBold"/>
                  <TextBlock x:Name="StorageCardText" Text="Cloudinary" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
                  <TextBlock Text="Proveedor conectado" FontSize="10" Foreground="#8294AD"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Style="{StaticResource PanelBorderStyle}" Margin="0" Padding="17">
                <StackPanel>
                  <TextBlock Text="ARCHIVOS" FontSize="10" Foreground="#8FA1BB" FontWeight="SemiBold"/>
                  <TextBlock x:Name="FileCountText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,5"/>
                  <TextBlock Text="Elementos en el historial" FontSize="10" Foreground="#8294AD"/>
                </StackPanel>
              </Border>
            </Grid>

            <Border Style="{StaticResource PanelBorderStyle}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,13">
                  <StackPanel>
                    <TextBlock Text="Actividad reciente" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Últimos archivos registrados en tu servidor" FontSize="11" Foreground="#8294AD" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button Content="Actualizar" Click="RefreshHistory_Click" HorizontalAlignment="Right" Margin="Auto,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="HistoryList" MinHeight="125" MaxHeight="240"/>
              </DockPanel>
            </Border>
          </StackPanel>

          <!-- FILES -->
          <StackPanel x:Name="FilesPage" Visibility="Collapsed">
            <Border Style="{StaticResource PanelBorderStyle}">
              <StackPanel>
                <Grid Margin="0,0,0,15">
                  <StackPanel>
                    <TextBlock Text="Biblioteca de archivos" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Consulta las cargas que siguen disponibles en el almacenamiento remoto." FontSize="11" Foreground="#8294AD" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button Content="↻  Actualizar lista" Click="RefreshHistory_Click" HorizontalAlignment="Right"/>
                </Grid>
                <Border Background="#0B1422" BorderBrush="#26364D" BorderThickness="1" CornerRadius="12" Padding="12">
                  <StackPanel>
                    <TextBlock Text="Contenido de tu biblioteca" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="La lista muestra nombre, tamaño y vencimiento. Los enlaces temporales se generan durante cada carga." FontSize="11" Foreground="#8294AD" Margin="0,5,0,11" TextWrapping="Wrap"/>
                    <ListBox x:Name="FilesList" MinHeight="260" MaxHeight="520"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- UPLOAD -->
          <StackPanel x:Name="UploadPage" Visibility="Collapsed">
            <Border Style="{StaticResource PanelBorderStyle}" Padding="24">
              <StackPanel>
                <TextBlock Text="Subir archivos" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Selecciona imágenes o documentos desde tu PC. Los archivos se enviarán al servidor configurado." Foreground="#91A0B8" FontSize="12" Margin="0,5,0,18" TextWrapping="Wrap"/>
                <Border BorderBrush="#3A5273" BorderThickness="1" CornerRadius="14" Background="#0D1727" Padding="28">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⇧" FontSize="36" Foreground="#A9CCFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Elige archivos de tu computadora" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                    <TextBlock Text="JPG · PNG · WEBP · PDF · TXT · DOCX · XLSX · PPTX y más" FontSize="10" Foreground="#8294AD" HorizontalAlignment="Center"/>
                    <Button Content="Seleccionar archivos…" Click="SelectUpload_Click" Background="#D9E8FF" Foreground="#14243C" BorderBrush="#D9E8FF" Margin="0,18,0,0"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="UploadStatusText" Text="No hay cargas en curso." Foreground="#AFC2DE" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ACTIVITY -->
          <StackPanel x:Name="ActivityPage" Visibility="Collapsed">
            <Border Style="{StaticResource PanelBorderStyle}">
              <StackPanel>
                <Grid Margin="0,0,0,14">
                  <StackPanel>
                    <TextBlock Text="Registro de actividad" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Historial de archivos subidos al servidor." FontSize="11" Foreground="#8294AD" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Button Content="Actualizar" Click="RefreshHistory_Click" HorizontalAlignment="Right"/>
                </Grid>
                <ListBox x:Name="ActivityList" MinHeight="300" MaxHeight="600"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- INTEGRATIONS -->
          <StackPanel x:Name="IntegrationsPage" Visibility="Collapsed">
            <Border Style="{StaticResource PanelBorderStyle}">
              <StackPanel>
                <TextBlock Text="Integraciones" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Conexiones disponibles para ImageBridge." FontSize="11" Foreground="#8294AD" Margin="0,4,0,16"/>
                <Border Background="#0D1727" BorderBrush="#2B405B" BorderThickness="1" CornerRadius="13" Padding="17" Margin="0,0,0,12">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" Background="#203B60"><TextBlock Text="✧" FontSize="24" Foreground="#BBD8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="ChatGPT Web" FontWeight="SemiBold" FontSize="14"/>
                      <TextBlock Text="Extensión Chrome / Edge · integración experimental mediante la interfaz web" FontSize="10" Foreground="#8294AD" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="EXPERIMENTAL" Foreground="#E8C58A" FontSize="9" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <Border Background="#0D1727" BorderBrush="#2B405B" BorderThickness="1" CornerRadius="13" Padding="17">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="12" Background="#203B60"><TextBlock Text="⌘" FontSize="22" Foreground="#BBD8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                      <TextBlock Text="API ImageBridge" FontWeight="SemiBold" FontSize="14"/>
                      <TextBlock Text="Worker HTTPS con almacenamiento Cloudinary y enlaces temporales." FontSize="10" Foreground="#8294AD" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="CONECTABLE" Foreground="#9BC9B1" FontSize="9" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <TextBlock Text="Nota: la integración web actual inserta enlaces en el mensaje; no equivale a un adjunto nativo ni garantiza que el modelo reciba los bytes del archivo." Foreground="#8294AD" FontSize="10" TextWrapping="Wrap" Margin="2,15,2,0"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- STORAGE -->
          <StackPanel x:Name="StoragePage" Visibility="Collapsed">
            <Border Style="{StaticResource PanelBorderStyle}">
              <StackPanel>
                <TextBlock Text="Almacenamiento" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Proveedor y políticas de retención del servidor conectado." FontSize="11" Foreground="#8294AD" Margin="0,4,0,18"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#0D1727" BorderBrush="#2B405B" BorderThickness="1" CornerRadius="13" Padding="17">
                    <StackPanel>
                      <TextBlock Text="PROVEEDOR" FontSize="9" Foreground="#8294AD"/>
                      <TextBlock x:Name="StorageProviderText" Text="Cloudinary" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,4"/>
                      <TextBlock Text="Recursos autenticados" FontSize="10" Foreground="#8294AD"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="#0D1727" BorderBrush="#2B405B" BorderThickness="1" CornerRadius="13" Padding="17">
                    <StackPanel>
                      <TextBlock Text="RETENCIÓN" FontSize="9" Foreground="#8294AD"/>
                      <TextBlock x:Name="RetentionText" Text="24 horas" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,4"/>
                      <TextBlock x:Name="UploadLimitText" Text="Límite por archivo: 15 MB" FontSize="10" Foreground="#8294AD"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <TextBlock Text="Los límites y cuotas finales dependen del plan de Cloudinary y de Cloudflare. Los archivos vencidos se eliminan mediante la tarea de limpieza programada." FontSize="11" Foreground="#8294AD" TextWrapping="Wrap" Margin="2,16,2,0"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- SETTINGS -->
          <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
            <Border Style="{StaticResource PanelBorderStyle}">
              <StackPanel>
                <TextBlock Text="Configuración" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Administra la conexión entre esta aplicación y tu servidor ImageBridge." FontSize="11" Foreground="#8294AD" Margin="0,4,0,18"/>
                <TextBlock Text="URL del servidor" FontSize="12" Foreground="#C5D2E4"/>
                <TextBox x:Name="ServerUrlBox" Text="https://imagebridge-storage.fert0480.workers.dev"/>
                <TextBlock Text="Token privado de ImageBridge" FontSize="12" Foreground="#C5D2E4"/>
                <PasswordBox x:Name="ApiTokenBox"/>
                <WrapPanel Margin="0,2,0,0">
                  <Button Content="Guardar configuración" Click="SaveSettings_Click" Background="#D9E8FF" Foreground="#14243C" BorderBrush="#D9E8FF"/>
                  <Button Content="Probar conexión" Click="Connect_Click"/>
                </WrapPanel>
                <TextBlock x:Name="SettingsStatusText" Text="El token se cifra con DPAPI y queda guardado para este usuario de Windows." Foreground="#91A0B8" FontSize="11" Margin="0,13,0,0" TextWrapping="Wrap"/>
                <Border Background="#0D1727" BorderBrush="#2B405B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,20,0,0">
                  <StackPanel>
                    <TextBlock Text="Privacidad y seguridad" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="El token no se muestra después de guardarlo. Se almacena cifrado localmente con DPAPI. Nunca lo compartas ni lo añadas al repositorio." FontSize="10" Foreground="#8294AD" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>

          <TextBlock Text="ImageBridge Desktop · Panel de administración · La integración de ChatGPT Web es experimental." Foreground="#667891" FontSize="10" Margin="2,5,2,12"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>