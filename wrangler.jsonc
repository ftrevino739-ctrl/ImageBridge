{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imagebridge-storage",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "imagebridge-files" }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "vars": {
    "MAX_UPLOAD_MB": "15",
    "TTL_HOURS": "24"
  }
}
